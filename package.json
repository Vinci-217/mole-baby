{
  "name": "mole-baby",
  "version": "0.29.4",
  "private": true,
  "description": "拉姆 · mole-baby 桌面宠物",
  "author": "mole-baby",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --maxWorkers=2 && node scripts/run-node-tests.cjs",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:portable": "npm run build && electron-builder --win zip --x64",
    "test:desktop:cloud": "npm run build && node scripts/desktop-smoke.cjs",
    "dist:mac": "npm run build && electron-builder --config electron-builder.mac.cjs --mac dmg zip && node scripts/notarize-mac-dmg.cjs",
    "dist:mac:arm64": "npm run build && electron-builder --config electron-builder.mac.cjs --mac dmg zip --arm64 && node scripts/notarize-mac-dmg.cjs arm64",
    "dist:mac:x64": "npm run build && electron-builder --config electron-builder.mac.cjs --mac dmg zip --x64 && node scripts/notarize-mac-dmg.cjs x64",
    "test:registered-wardrobe": "node scripts/registered-wardrobe-regression.cjs",
    "review:wardrobe": "node scripts/record-lively-review.cjs",
    "test:browser": "npm run build && node scripts/compact-care-regression.cjs",
    "clean:previews": "node scripts/clean-preview-frames.cjs --apply",
    "build:legacy": "tsc -b && vite build --config vite.legacy.config.ts",
    "dist:win:legacy:x64": "npm run build:legacy && cross-env MOLE_LEGACY_ARCH=x64 electron-builder --config electron-builder.legacy.cjs --win nsis zip --x64",
    "dist:win:legacy:ia32": "npm run build:legacy && cross-env MOLE_LEGACY_ARCH=ia32 electron-builder --config electron-builder.legacy.cjs --win nsis zip --ia32"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "com.molebaby.ramuhouse",
    "productName": "拉姆",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.node-test.cjs",
      "package.json",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/lucide-react/**/*",
      "!node_modules/scheduler/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "mole-baby-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "public/icons/ramu.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "mole-baby-${version}-Setup.${ext}",
      "installerIcon": "public/icons/ramu.ico",
      "uninstallerIcon": "public/icons/ramu.ico",
      "include": "electron/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "mole-baby-${version}-mac-${arch}.${ext}",
      "icon": "public/icons/ramu.icns",
      "minimumSystemVersion": "12.0",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "拉姆 ${version}",
      "contents": [
        {
          "x": 150,
          "y": 220
        },
        {
          "x": 430,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 580,
        "height": 400
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Vinci-217",
        "repo": "mole-baby",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en",
      "en-US",
      "zh-CN",
      "zh_CN"
    ],
    "compression": "maximum"
  }
}
