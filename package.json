{
  "name": "mole-baby",
  "version": "0.13.0",
  "private": true,
  "description": "拉姆 · mole-baby 桌面宠物",
  "author": "mole-baby",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test electron/deepseek.node-test.cjs electron/speech.node-test.cjs electron/mac-settings.node-test.cjs electron/desktop-geometry.node-test.cjs electron/desktop-lifecycle.node-test.cjs scripts/mac-signing.node-test.cjs",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:browser": "node scripts/smoke.cjs",
    "dist:win:portable": "npm run build && electron-builder --win zip --x64",
    "test:desktop:cloud": "node scripts/desktop-smoke.cjs",
    "test:memory": "node scripts/memory-regression.cjs",
    "dist:mac": "npm run build && electron-builder --config electron-builder.mac.cjs --mac dmg zip && node scripts/notarize-mac-dmg.cjs",
    "dist:mac:arm64": "npm run build && electron-builder --config electron-builder.mac.cjs --mac dmg zip --arm64 && node scripts/notarize-mac-dmg.cjs arm64",
    "dist:mac:x64": "npm run build && electron-builder --config electron-builder.mac.cjs --mac dmg zip --x64 && node scripts/notarize-mac-dmg.cjs x64",
    "test:companion-update": "node scripts/companion-update-regression.cjs",
    "test:social": "node scripts/social-motion-regression.cjs",
    "test:presence": "node scripts/presence-regression.cjs",
    "test:hover-rest": "node scripts/hover-rest-regression.cjs",
    "test:reading-dizzy": "node scripts/reading-dizzy-regression.cjs",
    "test:layout-stage": "node scripts/layout-stage-regression.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.molebaby.ramuhouse",
    "productName": "拉姆",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "mole-baby-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "public/icons/ramu.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "mole-baby-${version}-Setup.${ext}",
      "installerIcon": "public/icons/ramu.ico",
      "uninstallerIcon": "public/icons/ramu.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "mole-baby-${version}-mac-${arch}.${ext}",
      "icon": "public/icons/ramu.icns",
      "minimumSystemVersion": "12.0",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "拉姆 ${version}",
      "contents": [
        {
          "x": 150,
          "y": 220
        },
        {
          "x": 430,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 580,
        "height": 400
      }
    }
  }
}
