{
  "name": "mole-baby",
  "version": "0.6.0",
  "private": true,
  "description": "拉姆 · mole-baby 桌面宠物",
  "author": "mole-baby",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test electron/deepseek.node-test.cjs electron/speech.node-test.cjs electron/desktop-geometry.node-test.cjs electron/desktop-lifecycle.node-test.cjs",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:browser": "node scripts/smoke.cjs",
    "dist:win:portable": "npm run build && electron-builder --win zip --x64",
    "test:desktop:cloud": "node scripts/desktop-smoke.cjs",
    "test:memory": "node scripts/memory-regression.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.molebaby.ramuhouse",
    "productName": "拉姆",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "mole-baby-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "public/icons/ramu.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "mole-baby-${version}-Setup.${ext}",
      "installerIcon": "public/icons/ramu.ico",
      "uninstallerIcon": "public/icons/ramu.ico"
    }
  }
}
